# For the dev CLI, the sample builder and local runs only. The web app always uses each visitor's own
# key and models: never set these keys on a public server.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Provider and models for the CLI and the sample builder. There are no default models: name ones your key can use.
# PAGEINDEX_PROVIDER=anthropic       # anthropic | openai | google
# PAGEINDEX_INDEX_MODEL=             # summaries and image descriptions: a small, cheap model
# PAGEINDEX_AGENT_MODEL=             # the chat agent: must support tool calling
# PAGEINDEX_VISION_MODEL=            # defaults to the index model

# Optional overrides (defaults shown)
# PAGEINDEX_DATA_DIR=data
# PAGEINDEX_MAX_LEAF_TOKENS=2000
# PAGEINDEX_AGENT_MAX_STEPS=15
