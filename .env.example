# For the dev CLI and local runs only. The web app always uses each visitor's own key:
# never set these on a public server.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional overrides (defaults shown). Model defaults follow the provider.
# PAGEINDEX_PROVIDER=anthropic          # anthropic | openai | google
# PAGEINDEX_INDEX_MODEL=claude-haiku-5-5  (openai: gpt-6-luna, google: gemini-3.5-flash-lite)
# PAGEINDEX_VISION_MODEL=                 (defaults to the index model)
# PAGEINDEX_AGENT_MODEL=claude-sonnet-5-5 (openai: gpt-6.1-sol, google: gemini-3.6-flash)
# PAGEINDEX_DATA_DIR=data
# PAGEINDEX_MAX_LEAF_TOKENS=2000
# PAGEINDEX_AGENT_MAX_STEPS=15
