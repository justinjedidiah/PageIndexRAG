# For the dev CLI, the sample builder and local runs only. The web app always uses each visitor's own
# key and models: never set these keys on a public server.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Provider and models for the CLI and the sample builder. There are no default models: name ones your key can use.
# TOC_RAG_PROVIDER=anthropic       # anthropic | openai | google
# TOC_RAG_INDEX_MODEL=             # summaries and image descriptions: a small, cheap model
# TOC_RAG_AGENT_MODEL=             # the chat agent: must support tool calling
# TOC_RAG_VISION_MODEL=            # defaults to the index model

# Optional overrides (defaults shown)
# TOC_RAG_DATA_DIR=data
# TOC_RAG_MAX_LEAF_TOKENS=2000
# TOC_RAG_AGENT_MAX_STEPS=15
